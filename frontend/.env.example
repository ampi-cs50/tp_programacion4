# ==========================================
# Midori's Flow - Frontend Environment Configuration Template
# ==========================================
# Copy this file to .env inside the frontend/ directory:
#   cp .env.example .env

# Google OAuth 2.0 Client ID for React Google Identity Services
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Base API URL (defaults to /api/v1 proxied by Vite dev server to http://localhost:3000)
# VITE_API_URL=http://localhost:3000/api/v1
