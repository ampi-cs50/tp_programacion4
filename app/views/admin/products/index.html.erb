<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
  <h1>Productos</h1>
  <%= link_to "Nuevo Producto", new_admin_product_path, class: "btn-primary" %>
</div>

<table>
  <thead>
    <tr>
      <th>Imagen</th>
      <th>Nombre</th>
      <th>Categoría</th>
      <th>Precio</th>
      <th>Stock</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |prod| %>
      <tr>
        <td>
          <% if prod.images.attached? %>
            <%= image_tag prod.images.first, width: 50, style: "border-radius: 8px;" %>
          <% else %>
            <span style="color: var(--text-muted); font-size: 0.9em;">Sin foto</span>
          <% end %>
        </td>
        <td style="font-weight: 500;"><%= prod.name %></td>
        <td><span style="background: #f1f5f9; padding: 4px 10px; border-radius: 20px; font-size: 0.85em;"><%= prod.category&.name %></span></td>
        <td style="font-weight: 600; color: var(--primary-color);">$<%= prod.price %></td>
        <td><%= prod.stock %></td>
        <td style="display: flex; gap: 10px;">
          <%= link_to "Ver", admin_product_path(prod), class: "btn-outline", style: "padding: 4px 12px; font-size: 0.8rem;" %>
          <%= link_to "Editar", edit_admin_product_path(prod), class: "btn-outline", style: "padding: 4px 12px; font-size: 0.8rem;" %>
          <%= button_to "Eliminar", admin_product_path(prod), method: :delete, class: "btn-outline", style: "padding: 4px 12px; font-size: 0.8rem; color: var(--accent-color); border-color: var(--accent-color);" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>