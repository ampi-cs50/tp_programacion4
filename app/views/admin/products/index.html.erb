<h1>Productos</h1>
<%= link_to "Nuevo Producto", new_admin_product_path %>

<table border="1" cellpadding="8" style="margin-top: 15px; border-collapse: collapse;">
  <thead>
    <tr>
      <th>Imagen</th>
      <th>Nombre</th>
      <th>Categoría</th>
      <th>Precio</th>
      <th>Stock</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |prod| %>
      <tr>
        <td>
          <% if prod.images.attached? %>
            <%= image_tag prod.images.first, width: 50 %>
          <% else %>
            Sin foto
          <% end %>
        </td>
        <td><%= prod.name %></td>
        <td><%= prod.category&.name %></td>
        <td>$<%= prod.price %></td>
        <td><%= prod.stock %></td>
        <td>
          <%= link_to "Ver", admin_product_path(prod) %> |
          <%= link_to "Editar", edit_admin_product_path(prod) %> |
          <%= button_to "Eliminar", admin_product_path(prod), method: :delete %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>