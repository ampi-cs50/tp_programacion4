<h1>Dashboard general</h1>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; margin-top: 20px;">
  <!-- Tarjeta Categorías -->
  <div style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; padding: 24px; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-md); display: flex; flex-direction: column; justify-content: space-between;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 style="font-weight: 500; margin: 0;">Categorías</h3>
      <span style="font-size: 1.5rem; opacity: 0.8;">📁</span>
    </div>
    <span style="font-size: 2.5rem; font-weight: 700;"><%= @categories_count %></span>
    <div style="margin-top: 16px; font-size: 0.85rem; opacity: 0.9;">Total registradas</div>
  </div>

  <!-- Tarjeta Productos -->
  <div style="background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 24px; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-md); display: flex; flex-direction: column; justify-content: space-between;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 style="font-weight: 500; margin: 0;">Productos</h3>
      <span style="font-size: 1.5rem; opacity: 0.8;">📦</span>
    </div>
    <span style="font-size: 2.5rem; font-weight: 700;"><%= @products_count %></span>
    <div style="margin-top: 16px; font-size: 0.85rem; opacity: 0.9;">Total en stock</div>
  </div>

  <!-- Tarjeta Órdenes -->
  <div style="background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white; padding: 24px; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-md); display: flex; flex-direction: column; justify-content: space-between;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 style="font-weight: 500; margin: 0;">Órdenes</h3>
      <span style="font-size: 1.5rem; opacity: 0.8;">🛒</span>
    </div>
    <span style="font-size: 2.5rem; font-weight: 700;"><%= @orders_count %></span>
    <div style="margin-top: 16px; font-size: 0.85rem; opacity: 0.9;">Ventas realizadas</div>
  </div>
</div>