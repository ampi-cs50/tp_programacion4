<h1>Órdenes de Compra</h1>

<table border="1" cellpadding="8" style="margin-top: 15px; border-collapse: collapse; width: 100%;">
  <thead>
    <tr>
      <th>ID</th>
      <th>Usuario</th>
      <th>Fecha</th>
      <th>Total</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td>#<%= order.id %></td>
        <td><%= order.user.email_address %></td>
        <td><%= order.created_at.strftime("%d/%m/%Y %H:%M") %></td>
        <td>$<%= order.total %></td>
        <td><%= order.status %></td>
        <td>
          <%= link_to "Ver Detalle", admin_order_path(order) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
