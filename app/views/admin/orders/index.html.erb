<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
  <h1>Órdenes de Compra</h1>
</div>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Usuario</th>
      <th>Fecha</th>
      <th>Total</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td style="font-weight: 600; color: var(--secondary-color);">#<%= order.id %></td>
        <td><%= order.user.email_address %></td>
        <td style="color: var(--text-muted);"><%= order.created_at.strftime("%d/%m/%Y %H:%M") %></td>
        <td style="font-weight: 600; color: var(--primary-color);">$<%= order.total %></td>
        <td>
          <span style="background: <%= order.status == 'pending' ? '#fef3c7' : '#dcfce7' %>; color: <%= order.status == 'pending' ? '#d97706' : '#15803d' %>; padding: 4px 10px; border-radius: 20px; font-size: 0.85em; font-weight: 500;">
            <%= order.status %>
          </span>
        </td>
        <td>
          <%= link_to "Ver Detalle", admin_order_path(order), class: "btn-outline", style: "padding: 4px 12px; font-size: 0.8rem;" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
