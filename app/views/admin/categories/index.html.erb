<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
  <h1>Categorías</h1>
  <%= link_to "Nueva Categoría", new_admin_category_path, class: "btn-primary" %>
</div>

<div class="category-list" style="display: flex; flex-direction: column; gap: 16px;">
  <% @categories.each do |cat| %>
    <div style="border: 1px solid var(--border-color); border-radius: var(--border-radius-md); padding: 16px; background: #fff;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <strong style="font-size: 1.1rem; color: var(--secondary-color);"><%= cat.name %></strong>
          <span style="background: var(--primary-color); color: #fff; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem;">Principal</span>
        </div>
        
        <div style="display: flex; gap: 8px;">
          <%= link_to "Ver", admin_category_path(cat), class: "btn-outline", style: "padding: 4px 12px; font-size: 0.8rem;" %>
          <%= link_to "Editar", edit_admin_category_path(cat), class: "btn-outline", style: "padding: 4px 12px; font-size: 0.8rem;" %>
          <%= button_to "Eliminar", admin_category_path(cat), method: :delete, class: "btn-outline", style: "padding: 4px 12px; font-size: 0.8rem; color: var(--accent-color); border-color: var(--accent-color);" %>
        </div>
      </div>
      
      <% if cat.subcategories.any? %>
        <div style="margin-top: 16px; padding-left: 16px; border-left: 2px solid #e2e8f0; display: flex; flex-direction: column; gap: 12px;">
          <% cat.subcategories.each do |sub| %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px; background: #f8fafc; border-radius: 8px;">
              <span style="color: var(--text-main); font-weight: 500;"><%= sub.name %></span>
              <div style="display: flex; gap: 8px;">
                <%= link_to "Ver", admin_category_path(sub), class: "btn-outline", style: "padding: 2px 8px; font-size: 0.75rem;" %>
                <%= link_to "Editar", edit_admin_category_path(sub), class: "btn-outline", style: "padding: 2px 8px; font-size: 0.75rem;" %>
                <%= button_to "Eliminar", admin_category_path(sub), method: :delete, class: "btn-outline", style: "padding: 2px 8px; font-size: 0.75rem; color: var(--accent-color); border-color: var(--accent-color);" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>