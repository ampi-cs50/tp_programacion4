<!DOCTYPE html>
<html>
  <head>
    <title>Admin - Tienda</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
  </head>

  <body>
    <div class="admin-layout">
      <!-- SIDEBAR -->
      <aside class="admin-sidebar">
        <div class="sidebar-brand">
          <h2>Panel de Control</h2>
        </div>
        <nav class="sidebar-nav">
          <%= link_to admin_root_path, class: "nav-item" do %>
            <span class="icon">📊</span> Dashboard
          <% end %>
          <%= link_to admin_categories_path, class: "nav-item" do %>
            <span class="icon">📁</span> Categorías
          <% end %>
          <%= link_to admin_products_path, class: "nav-item" do %>
            <span class="icon">📦</span> Productos
          <% end %>
          <%= link_to admin_orders_path, class: "nav-item" do %>
            <span class="icon">🛒</span> Órdenes
          <% end %>
        </nav>
      </aside>

      <!-- MAIN AREA -->
      <div class="admin-main">
        <header class="admin-header">
          <div class="header-search">
            <!-- Espacio para buscador en el futuro -->
          </div>
          <div class="header-user">
            <span class="user-email">👤 <%= Current.user&.email_address %></span>
            <%= link_to "Volver al sitio", root_path, class: "btn-outline" %>
          </div>
        </header>

        <main class="admin-content">
          <% if notice %>
            <div class="flash flash-notice"><%= notice %></div>
          <% end %>
          <% if alert %>
            <div class="flash flash-alert"><%= alert %></div>
          <% end %>

          <div class="content-wrapper">
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>