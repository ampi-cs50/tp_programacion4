# ==========================================
# Midori's Flow - Backend Environment Configuration Template
# ==========================================
# Copy this file to .env and adjust variables according to your local environment.
# DO NOT commit real secrets or production credentials to version control.

# Google OAuth 2.0 Client ID (Used for verifying Google ID Tokens in /api/v1/auth/google)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Optional: Host configuration
# RAILS_ENV=development
# PORT=3000
